  - m_Id: 1
    m_Localized: "Los muros de Jeric\xF3"
    m_Metadata:
      m_Items: []
  - m_Id: 2
    m_Localized: "La prisi\xF3n de Pablo y Silas / La prisi\xF3n de Filipos"
    m_Metadata:
      m_Items: []
  - m_Id: 3
    m_Localized: "El asesinato de S\xEDsara por Jael / La tienda cerca de Cedes,
      en Cana\xE1n"
    m_Metadata:
      m_Items: []
  - m_Id: 4
    m_Localized: "El tabern\xE1culo / El lugar santo"
    m_Metadata:
      m_Items: []
  - m_Id: 5
    m_Localized: El mar Rojo dividido
    m_Metadata:
      m_Items: []
  - m_Id: 6
    m_Localized: El estudio de los sabios / El observatorio de los magos
    m_Metadata:
      m_Items: []
  - m_Id: 7
    m_Localized: "El r\xEDo Jord\xE1n dividido"
    m_Metadata:
      m_Items: []
  - m_Id: 8
    m_Localized: Los peces asados / Junto al mar de Tiberias
    m_Metadata:
      m_Items: []
  - m_Id: 9
    m_Localized: El horno de fuego / Babilonia
    m_Metadata:
      m_Items: []
  - m_Id: 10
    m_Localized: "El interior del arca de No\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 11
    m_Localized: "El segundo d\xEDa de la creaci\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 12
    m_Localized: El sacrificio de Abraham / El monte Moriah
    m_Metadata:
      m_Items: []
  - m_Id: 13
    m_Localized: "El jard\xEDn de Ed\xE9n"
    m_Metadata:
      m_Items: []
  - m_Id: 14
